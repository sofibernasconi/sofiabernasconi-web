# Images we don't want Google to show in search results or Google Images
# (they still display normally on the site)
/assets/sofia-bernasconi-deshilacha-2.jpg
  X-Robots-Tag: noindex
/assets/og.jpg
  X-Robots-Tag: noindex

# Logo: p5 and the Syne font are self-hosted and never change -> cache for a year
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
